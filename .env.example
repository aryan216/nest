MONGODB_URI=mongodb://127.0.0.1:27017/nestverify
MONGODB_DB=nestverify
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919876500000
STORAGE_DRIVER=local

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional production OTP delivery. Without this, codes are shown only in development.
OTP_WEBHOOK_URL=

# Optional S3-compatible storage when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=

# Optional ImageKit when STORAGE_DRIVER=imagekit
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=

# Optional Cloudinary when STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
